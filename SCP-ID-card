<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SCP SECURE ACCESS CARD SITE 19 00929983221</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #000000;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .card-container {
            width: 100%;
            max-width: 480px;
            background-color: #000000;
            border: 1px solid #ffffff;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .header {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            text-align: center;
            border-bottom: 1px solid #ffffff;
            padding-bottom: 12px;
            color: #ffffff;
            line-height: 1.4;
        }

        .top-section {
            display: flex;
            gap: 20px;
        }

        .photo-box {
            width: 120px;
            height: 120px;
            border: 1px solid #ffffff;
            position: relative;
            background-color: #000000;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .photo-box video,
        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .photo-btn {
            background: #000000;
            color: #ffffff;
            border: 1px solid #ffffff;
            padding: 6px 10px;
            font-size: 10px;
            letter-spacing: 1px;
            cursor: pointer;
            text-transform: uppercase;
            z-index: 2;
        }

        .photo-btn:hover {
            background: #ffffff;
            color: #000000;
        }

        .names-grid {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-grow: 1;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            border-top: 1px solid #ffffff;
            padding-top: 20px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .field label {
            font-size: 9px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #888888;
        }

        .field input {
            background: transparent;
            border: none;
            border-bottom: 1px solid #333333;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            padding: 4px 0;
            outline: none;
            width: 100%;
        }

        .field input:focus {
            border-bottom-color: #ffffff;
        }

        .actions {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end;
        }

        .action-btn {
            background: #000000;
            color: #ffffff;
            border: 1px solid #ffffff;
            padding: 10px 18px;
            font-size: 11px;
            letter-spacing: 1px;
            cursor: pointer;
            text-transform: uppercase;
            width: 100%;
        }

        .action-btn:hover {
            background: #ffffff;
            color: #000000;
        }

        /* Locked State Adjustments */
        .locked input {
            border-bottom-color: transparent !important;
            pointer-events: none;
        }

        .locked .photo-btn {
            display: none;
        }
    </style>
</head>
<body>

    <div class="card-container" id="card">
        <div class="header">
            SCP SECURE ACCESS CARD SITE 19 00929983221
        </div>

        <div class="top-section">
            <div class="photo-box" id="photoBox">
                <video id="webcam" autoplay playsinline></video>
                <img id="photoResult" alt="Captured Photo">
                <button class="photo-btn" id="cameraBtn" onclick="handleCamera()">CAMERA</button>
            </div>

            <div class="names-grid">
                <div class="field">
                    <label>FIRST NAME</label>
                    <input type="text" id="fn">
                </div>
                <div class="field">
                    <label>MIDDLE NAME</label>
                    <input type="text" id="mn">
                </div>
                <div class="field">
                    <label>LAST NAME</label>
                    <input type="text" id="ln">
                </div>
            </div>
        </div>

        <div class="details-grid">
            <div class="field">
                <label>AGE</label>
                <input type="text" id="age">
            </div>
            <div class="field">
                <label>HEIGHT</label>
                <input type="text" id="height">
            </div>
            <div class="field">
                <label>WEIGHT</label>
                <input type="text" id="weight">
            </div>
            <div class="field">
                <label>YEAR OF BIRTH</label>
                <input type="text" id="yob">
            </div>
        </div>

        <div class="actions">
            <button class="action-btn" id="lockBtn" onclick="toggleLock()">LOCK ID</button>
        </div>
    </div>

    <script>
        let stream = null;
        let cameraState = 'idle'; // idle, streaming, captured
        let isLocked = false;

        const video = document.getElementById('webcam');
        const photoResult = document.getElementById('photoResult');
        const cameraBtn = document.getElementById('cameraBtn');
        const card = document.getElementById('card');
        const lockBtn = document.getElementById('lockBtn');

        async function handleCamera() {
            if (cameraState === 'idle') {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: { aspectRatio: 1 } });
                    video.srcObject = stream;
                    video.style.display = 'block';
                    photoResult.style.display = 'none';
                    cameraBtn.innerText = 'SNAP';
                    cameraState = 'streaming';
                } catch (err) {
                    alert('Camera access denied or unavailable.');
                }
            } else if (cameraState === 'streaming') {
                const canvas = document.createElement('canvas');
                canvas.width = 300;
                canvas.height = 300;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, 300, 300);

                photoResult.src = canvas.toDataURL('image/png');
                photoResult.style.display = 'block';
                video.style.display = 'none';

                if (stream) {
                    stream.getTracks().forEach(track => track.stop());
                }

                cameraBtn.innerText = 'RETRACT';
                cameraState = 'captured';
            } else if (cameraState === 'captured') {
                photoResult.style.display = 'none';
                photoResult.src = '';
                cameraBtn.innerText = 'CAMERA';
                cameraState = 'idle';
            }
        }

        function toggleLock() {
            isLocked = !isLocked;
            if (isLocked) {
                card.classList.add('locked');
                lockBtn.innerText = 'UNLOCK ID';
            } else {
                card.classList.remove('locked');
                lockBtn.innerText = 'LOCK ID';
            }
        }
    </script>
</body>
</html>
